# Copy to .env for local development. In cPanel, set these in
# Setup Node.js App -> Environment variables instead (they override .env).

NODE_ENV=production

# MySQL / MariaDB
DB_HOST=localhost
DB_USER=cpaneluser_dbuser
DB_PASSWORD=change-me
DB_NAME=cpaneluser_tidali

# Admin login tokens — use a long random string, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=3d

# Optional: where uploaded images/videos are stored. Keep it outside the
# application root in production so redeploys don't remove uploads.
# Defaults to <project root>/public/uploads.
# UPLOADS_DIR=/home/cpaneluser/tidali-uploads

# Optional: local port only. Passenger ignores this and assigns its own socket.
# PORT=3000
