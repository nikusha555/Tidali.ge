<!DOCTYPE html>
<html lang="en">
<%- include('../../partials/head') %>

    <body>
        <div class="wrapper">
            <%- include('../../partials/side-navbar') %>
                <%- include('../../partials/header') %>

                    <div class="page-content">
                        <div class="page-container">
                            <div class="d-flex justify-content-center px-2">
                                <div class="col-12 col-sm-10 col-md-8 col-lg-6">

                                    <div class="card">

                                        <div class="card-header border-bottom border-dashed">
                                            <h4 class="header-title">ჩვენს შესახებ რედაქტირება</h4>
                                        </div>

                                        <div class="card-body pt-3 pb-2">

                                            <!-- ================= UPDATE FORM ================= -->
                                            <form action="<%= adminBase %>/edit-about/update" method="POST"
                                                enctype="multipart/form-data">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                                <div class="row">

                                                    <!-- IMAGE -->
                                                    <div class="col-md-6 text-center mb-4">

                                                        <% if (about.img_url) { %>
                                                            <img src="<%= about.img_url %>"
                                                                class="img-fluid rounded shadow mb-2"
                                                                style="max-height:250px">
                                                            <% } %>

                                                                <% if (about.img_url) { %>
                                                                    <button type="button" class="btn btn-danger btn-sm"
                                                                        onclick="deleteImage()">
                                                                        🗑 სურათის წაშლა
                                                                    </button>
                                                                    <% } %>

                                                                        <div class="dz-message mt-3" id="uploadTrigger"
                                                                            style="cursor:pointer">
                                                                            <i
                                                                                class="ti ti-cloud-upload h1 text-muted"></i>
                                                                            <h6>ახალი სურათი</h6>
                                                                            <input type="file" name="image"
                                                                                id="imageInput" accept="image/*" hidden>
                                                                        </div>

                                                                        <img id="imagePreview"
                                                                            class="img-fluid mt-3 d-none"
                                                                            style="max-height:200px">
                                                    </div>

                                                    <!-- VIDEO -->
                                                    <div class="col-md-6 text-center mb-4">

                                                        <% if (about.video_url) { %>
                                                            <video controls class="img-fluid rounded shadow mb-2"
                                                                style="max-height:250px">
                                                                <source src="<%= about.video_url %>">
                                                            </video>
                                                            <% } %>

                                                                <% if (about.video_url) { %>
                                                                    <button type="button" class="btn btn-danger btn-sm"
                                                                        onclick="deleteVideo()">
                                                                        🗑 ვიდეოს წაშლა
                                                                    </button>
                                                                    <% } %>

                                                                        <div class="dz-message mt-3"
                                                                            id="videoUploadTrigger"
                                                                            style="cursor:pointer">
                                                                            <i
                                                                                class="ti ti-cloud-upload h1 text-muted"></i>
                                                                            <h6>ახალი ვიდეო</h6>
                                                                            <input type="file" name="video"
                                                                                id="videoInput" accept="video/*" hidden>
                                                                        </div>
                                                    </div>

                                                </div>

                                                <!-- TEXT -->
                                                <input class="form-control mb-3" name="title" value="<%= about.title %>"
                                                    required>

                                                <textarea class="form-control mb-3" name="content" rows="5"
                                                    required><%= about.content %></textarea>

                                                <!-- SEO -->
                                                <div class="collapse" id="seoSettings">
                                                    <textarea class="form-control mb-2"
                                                        name="m_description"><%= about.m_description %></textarea>

                                                    <input class="form-control" name="m_keywords"
                                                        value="<%= about.m_keywords %>">
                                                </div>

                                                <div class="text-center mt-4">
                                                    <button class="btn btn-success px-4">
                                                        შენახვა
                                                    </button>
                                                </div>

                                            </form>
                                            <!-- ================= END UPDATE FORM ================= -->

                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
        </div>

        <script>
            const trigger = document.getElementById('uploadTrigger');
            const input = document.getElementById('imageInput');
            const preview = document.getElementById('imagePreview');

            if (trigger) {
                trigger.onclick = () => input.click();
                input.onchange = () => {
                    const file = input.files[0];
                    if (!file) return;
                    preview.src = URL.createObjectURL(file);
                    preview.classList.remove('d-none');
                };
            }

            const videoTrigger = document.getElementById('videoUploadTrigger');
            const videoInput = document.getElementById('videoInput');

            if (videoTrigger) {
                videoTrigger.onclick = () => videoInput.click();
            }




            async function deleteImage() {
                if (!confirm('წავშალო სურათი?')) return;

                await fetch('<%= adminBase %>/edit-about/media/delete-image', {
                    method: 'POST',
                    headers: { 'X-CSRF-Token': '<%= csrfToken %>' }
                });

                location.reload();
            }

            async function deleteVideo() {
                if (!confirm('წავშალო ვიდეო?')) return;

                await fetch('<%= adminBase %>/edit-about/media/delete-video', {
                    method: 'POST',
                    headers: { 'X-CSRF-Token': '<%= csrfToken %>' }
                });

                location.reload();
            }



        </script>

        <%- include('../../partials/footer') %>
    </body>

</html>